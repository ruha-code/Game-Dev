/*
2026-05-14 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
.root {
    flex-grow: 1;
    background-color: black;
    align-items: center;
    justify-content: center;
}

.background-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 2s ease-in-out;
}

.background-glow--visible {
    opacity: 1;
}

.content-container {
    align-items: center;
    justify-content: center;
}

.logo {
    font-size: 80px;
    color: white;
    -unity-font-style: bold;
    opacity: 0;
    transition: opacity 1s ease-in-out;
    text-shadow: 0 0 25px rgba(0, 180, 255, 0.9);
}

.logo--visible {
    opacity: 1;
}

.loading-container {
    margin-top: 50px;
    width: 400px;
    height: 10px;
    background-color: rgba(0, 50, 100, 0.4);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.5s ease-in;
}

.loading-container--visible {
    opacity: 1;
}

.loading-bar {
    width: 0%;
    height: 100%;
    background-color: rgb(0, 180, 255);
    border-radius: 5px;
    /* Simulate gloss with a child or gradient if possible, 
       but here we'll use a semi-transparent highlight in UXML if needed.
       For now, just a bright cyan. */
}

.setup-panel {
    position: absolute;
    width: 600px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.5);
    border-radius: 32px;
    padding: 60px;
    align-items: center;
    opacity: 0;
    scale: 0.9 0.9;
    transition: opacity 0.8s ease-out, scale 0.8s ease-out-back;
    display: none;
    -unity-background-image-tint-color: white;
}

.setup-panel--visible {
    opacity: 1;
    scale: 1 1;
    display: flex;
}

/* Glossy highlight for the panel */
.glass-reflection {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 45%;
    background-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.setup-title {
    font-size: 42px;
    color: white;
    margin-bottom: 16px;
    -unity-font-style: bold;
    text-shadow: 0 4px 8px rgba(0, 40, 80, 0.4);
    letter-spacing: 1px;
}

.setup-subtitle {
    font-size: 22px;
    color: rgba(220, 245, 255, 0.95);
    margin-bottom: 50px;
    -unity-text-align: middle-center;
}

.name-input {
    width: 100%;
    margin-bottom: 50px;
    color: white;
    font-size: 20px;
}

.name-input #unity-text-input {
    background-color: rgba(0, 30, 60, 0.4);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 16px;
    padding: 15px 20px;
    color: white;
    transition: border-color 0.3s, background-color 0.3s, box-shadow 0.3s;
}

.name-input #unity-text-input:focus {
    border-color: rgba(0, 190, 255, 0.9);
    background-color: rgba(0, 50, 100, 0.5);
}

.continue-button {
    background-color: rgba(0, 140, 255, 0.6);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 35px;
    padding: 18px 65px;
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    transition: background-color 0.3s, scale 0.2s, box-shadow 0.3s;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
}

.continue-button:hover {
    background-color: rgba(0, 180, 255, 0.8);
    scale: 1.05 1.05;
}

.continue-button:active {
    background-color: rgba(0, 110, 255, 1);
    scale: 0.95 0.95;
    transition-duration: 0.1s;
}

/* Glitch Effects */
.glitch-distort {
    translate: 30px 0;
}

.glitch-rgb {
    -unity-background-image-tint-color: rgba(255, 80, 80, 0.7);
}

.glitch-static {
    background-color: rgba(255, 255, 255, 0.08);
}

.fade-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: black;
    opacity: 0;
}
