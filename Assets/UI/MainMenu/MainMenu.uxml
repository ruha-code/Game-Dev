<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:aero="AeroOS.UI">
    <ui:Style src="MainMenu.uss" />
    <ui:VisualElement name="root" class="main-container">
        
        <aero:AeroAtmosphere class="atmosphere-overlay" />
        <aero:AeroSwoosh class="swoosh-overlay" />

        <ui:VisualElement name="header" class="header">
            <ui:Label text="AeroOS" name="title" class="title">
                <ui:VisualElement name="eye-left" class="logo-eye" style="left: 630px;" />
                <ui:VisualElement name="eye-right" class="logo-eye" style="left: 890px;" />
            </ui:Label>
            <ui:Label text="BEYOND THE SCREEN" name="subtitle" class="subtitle" />
        </ui:VisualElement>

        <ui:VisualElement name="menu" class="menu-box">
            <ui:VisualElement name="glass-reflection" class="ghost-reflection" />
<ui:VisualElement name="new-game-item" class="menu-item menu-item-active">
                <aero:AeroActiveBackground style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
                <ui:VisualElement class="menu-item-content">
                    <ui:VisualElement class="menu-icon" style="background-image: url('project://database/Assets/UI/Icons/play.svg');" />
                    <ui:Label text="New Game" class="menu-text" />
                    <ui:VisualElement class="menu-chevron" style="background-image: url('project://database/Assets/UI/Icons/chevron-right.svg');" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <ui:VisualElement name="continue-item" class="menu-item">
                <ui:VisualElement class="menu-item-content">
                    <ui:VisualElement class="menu-icon" style="background-image: url('project://database/Assets/UI/Icons/folder.svg');" />
                    <ui:Label text="Continue" class="menu-text" />
                    <ui:VisualElement class="menu-chevron" style="background-image: url('project://database/Assets/UI/Icons/chevron-right.svg'); display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="settings-item" class="menu-item">
                <ui:VisualElement class="menu-item-content">
                    <ui:VisualElement class="menu-icon" style="background-image: url('project://database/Assets/UI/Icons/gear.svg');" />
                    <ui:Label text="Settings" class="menu-text" />
                    <ui:VisualElement class="menu-chevron" style="background-image: url('project://database/Assets/UI/Icons/chevron-right.svg'); display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="credits-item" class="menu-item">
                <ui:VisualElement class="menu-item-content">
                    <ui:VisualElement class="menu-icon" style="background-image: url('project://database/Assets/UI/Icons/book.svg');" />
                    <ui:Label text="Credits" class="menu-text" />
                    <ui:VisualElement class="menu-chevron" style="background-image: url('project://database/Assets/UI/Icons/chevron-right.svg'); display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="quit-item" class="menu-item">
                <ui:VisualElement class="menu-item-content">
                    <ui:VisualElement class="menu-icon" style="background-image: url('project://database/Assets/UI/Icons/power.svg');" />
                    <ui:Label text="Quit" class="menu-text" />
                    <ui:VisualElement class="menu-chevron" style="background-image: url('project://database/Assets/UI/Icons/chevron-right.svg'); display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="footer" class="footer">
            <ui:VisualElement name="user-section" class="user-section">
                <ui:VisualElement class="user-icon" style="background-image: url('project://database/Assets/UI/Icons/user.svg');" />
                <ui:VisualElement class="user-info">
                    <ui:Label text="Welcome." class="user-welcome" />
                    <ui:Label text="Prepare to log in to AeroOS." class="user-subtext" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="footer-right" style="align-items: flex-end;">
                <ui:Label name="clock-text" text="00:00" class="clock-text" />
                <ui:Label text="v 1.0.0" class="version-text" />
            </ui:VisualElement>
            </ui:VisualElement>

        <ui:VisualElement name="settings-panel" class="panel-overlay">
            <ui:VisualElement class="panel-content panel-content--settings">
                <ui:Label text="System Settings" class="panel-header" />
                <ui:Label text="Tune the AeroOS shell before entering the recovered session." class="panel-subtitle" />

                <ui:VisualElement class="settings-card">
                    <ui:VisualElement class="setting-block">
                        <ui:VisualElement class="setting-copy">
                            <ui:Label text="Master Volume" class="setting-label" />
                            <ui:Label text="Controls menu ambience, effects, and system anomalies." class="setting-description" />
                        </ui:VisualElement>
                        <ui:VisualElement class="setting-meta-row">
                            <ui:Label text="OUTPUT LEVEL" class="setting-meta-label" />
                            <ui:Label name="master-vol-value" text="100%" class="setting-meta-value" />
                        </ui:VisualElement>
                        <ui:Slider name="master-vol" low-value="0" high-value="1" value="1" class="settings-slider" />
                    </ui:VisualElement>

                    <ui:VisualElement class="setting-block setting-block--toggle">
                        <ui:VisualElement class="setting-copy">
                            <ui:Label text="Fullscreen" class="setting-label" />
                            <ui:Label text="Keep the desktop sealed inside a full-screen shell." class="setting-description" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-toggle-row">
                            <ui:Label name="fullscreen-value" text="Enabled" class="setting-meta-value" />
                            <ui:Toggle name="fullscreen-toggle" value="true" class="settings-toggle" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="panel-footer">
                    <ui:Button text="Close" name="settings-close" class="close-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="credits-panel" class="panel-overlay">
            <ui:VisualElement class="panel-content panel-content--credits">
                <ui:Label text="Credits" class="panel-header" />
                <ui:Label text="Built inside the recovered AeroOS environment." class="panel-subtitle" />

                <ui:VisualElement class="credits-card">
                    <ui:VisualElement class="credits-section">
                        <ui:Label text="Core Team" class="credits-section-title" />
                        <ui:VisualElement class="credits-name-list">
                            <ui:Label text="Ruslan" class="credits-name" />
                            <ui:Label text="Dastan" class="credits-name" />
                            <ui:Label text="Bekassyl" class="credits-name" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="credits-section">
                        <ui:Label text="Special Systems" class="credits-section-title" />
                        <ui:Label text="AeroOS AI audio and atmospheric support" class="credits-detail" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="panel-footer">
                    <ui:Button text="Close" name="credits-close" class="close-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="anomaly-container" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
            <ui:VisualElement name="player-shadow" class="anomaly-shadow" />
            <ui:VisualElement name="digital-ghost" class="anomaly-ghost" />
            <ui:VisualElement name="system-popup" class="anomaly-popup">
                <ui:Label name="popup-text" text="Scanning..." />
            </ui:VisualElement>
            <ui:VisualElement name="fake-load" class="anomaly-load">
                <ui:Label text="Synchronizing..." class="load-text" />
                <ui:VisualElement class="load-bar-bg">
                    <ui:VisualElement name="load-bar-fill" class="load-bar-fill" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="startup-disclaimer" class="startup-disclaimer">
            <ui:VisualElement name="startup-disclaimer-card" class="startup-disclaimer-card">
                <ui:Label text="Content Warning" class="startup-disclaimer-title" />
                <ui:Label text="This game contains frequent visual glitches, bright flashes, unsettling imagery, sudden loud sounds, and intense horror sequences." class="startup-disclaimer-body" />
                <ui:Label text="If you are sensitive to flashing lights or abrupt audio spikes, please play carefully and consider lowering volume before continuing." class="startup-disclaimer-body startup-disclaimer-body--secondary" />
                <ui:Label text="Read this warning before entering the AeroOS shell." class="startup-disclaimer-hint" />
                <ui:Button text="Continue" name="startup-disclaimer-continue" class="startup-disclaimer-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="fade-overlay" class="fade-overlay" picking-mode="Ignore">
<ui:VisualElement name="loading-container" class="loading-container">
                <ui:Label text="AeroOS" name="loading-logo" class="loading-logo" />
                <ui:VisualElement class="loading-spinner" />
                <ui:Label text="INITIALIZING AeroOS..." class="loading-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        </ui:VisualElement>
        </ui:UXML>
