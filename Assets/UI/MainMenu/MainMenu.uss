/*
2026-05-13 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
/*
AeroOS Main Menu Styles - Final Polish & Alignment Fix
*/
:root {
    --color-primary: #a3e0ff;
    --color-accent: #00d2ff;
    --color-text: #ffffff;
    --color-glass-bg: rgba(255, 255, 255, 0.03);
    --color-glass-border: rgba(255, 255, 255, 0.2);
    --color-highlight: rgba(120, 209, 255, 0.25);
    --spacing-lg: 80px;
    --border-radius: 20px;
}

.main-container {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project://database/Assets/UI/background_menu.png");
    -unity-background-scale-mode: scale-and-crop;
    /* Removed padding to fix absolute child alignment (black bar) */
    justify-content: space-between;
    transition-property: opacity, -unity-background-image-tint-color;
    transition-duration: 0.8s;
}

.header {
    margin: 80px;
    margin-bottom: 30px;
    align-items: flex-start;
}

.title {
    font-size: 160px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: -10px;
    /* Cleaner glow with tighter focus to reduce blur/jaggedness */
    text-shadow: 0 0 15px rgba(90, 200, 255, 0.4);
}

.subtitle {
    font-size: 18px;
    color: var(--color-primary);
    letter-spacing: 12px; 
    opacity: 0.8;
    margin-left: 38px; /* Balanced alignment for the slanted AeroOS logo */
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}

.menu-box {
    background-color: var(--color-glass-bg);
    border-width: 2px;
    border-color: var(--color-glass-border);
    border-radius: var(--border-radius);
    padding: 12px;
    width: 520px; /* Increased width to prevent text wrap */
    border-top-color: rgba(255, 255, 255, 0.35);
    border-left-color: rgba(255, 255, 255, 0.15);
    margin-left: 80px;
}

.menu-item {
    flex-direction: row;
    align-items: center;
    padding: 14px 24px;
    margin: 4px;
    border-radius: 14px;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.2s;
    overflow: hidden;
    border-width: 1px;
    border-color: transparent;
    height: 60px; /* Explicit height for stability */
}

.menu-item-content {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 100%;
}

.menu-item:hover {
    scale: 1.05;
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
}

.menu-item:active {
    scale: 0.97;
    background-color: rgba(120, 209, 255, 0.15);
}

.menu-item-active {
    border-color: rgba(255, 255, 255, 0.9);
    background-color: rgba(255, 255, 255, 0.12);
}

.menu-item-active .menu-chevron {
    opacity: 1;
}

.menu-item-disabled {
    opacity: 0.3;
}

.menu-item-disabled .menu-text {
    color: rgba(255, 255, 255, 0.5);
}

.menu-icon {
    width: 32px;
    height: 32px;
    margin-right: 25px;
    -unity-background-image-tint-color: white;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.menu-text {
    font-size: 30px;
    color: var(--color-text);
    flex-grow: 1;
    -unity-font-style: normal;
    white-space: nowrap; /* Prevent wrapping */
    -unity-text-align: middle-left;
}

.menu-chevron {
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: white;
    opacity: 0.7;
    flex-shrink: 0;
}

.atmosphere-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.swoosh-overlay {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 240px;
    opacity: 0.5;
}

.footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin: 80px;
}

.user-section {
    flex-direction: row;
    align-items: center;
}

.user-icon {
    width: 52px;
    height: 52px;
    margin-right: 18px;
    -unity-background-image-tint-color: white;
    -unity-background-scale-mode: scale-to-fit;
}

.user-welcome {
    font-size: 24px;
    color: var(--color-text);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.user-subtext {
    font-size: 16px;
    color: var(--color-text);
    opacity: 0.8;
    -unity-text-align: middle-left;
    margin: 0;
}

.clock-text {
    font-size: 28px;
    color: var(--color-primary);
    -unity-font-style: bold;
    letter-spacing: 2px;
    opacity: 0.6;
    margin-bottom: 5px;
}

.panel-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(4, 14, 32, 0.62);
    justify-content: center;
    align-items: center;
    display: none;
    opacity: 0;
    transition-duration: 0.35s;
}

.startup-disclaimer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(1, 5, 12, 0.86);
    opacity: 0;
    display: none;
}

.startup-disclaimer-card {
    width: 760px;
    max-width: 82%;
    padding: 28px 32px 26px 32px;
    background-color: rgba(10, 26, 45, 0.78);
    border-width: 1px;
    border-color: rgba(163, 224, 255, 0.28);
    border-top-color: rgba(255, 255, 255, 0.42);
    border-left-color: rgba(255, 255, 255, 0.16);
    border-radius: 22px;
}

.startup-disclaimer-title {
    font-size: 34px;
    color: white;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 12px;
}

.startup-disclaimer-body {
    font-size: 18px;
    color: rgba(232, 245, 255, 0.96);
    line-height: 26px;
    margin-bottom: 12px;
    white-space: normal;
}

.startup-disclaimer-body--secondary {
    color: rgba(193, 221, 245, 0.88);
    margin-bottom: 18px;
}

.startup-disclaimer-hint {
    font-size: 13px;
    color: rgba(163, 224, 255, 0.9);
    letter-spacing: 1.6px;
    -unity-font-style: bold;
    text-transform: uppercase;
}

.startup-disclaimer-button {
    margin-top: 20px;
    min-width: 190px;
    height: 48px;
    padding: 0 24px;
    align-self: flex-end;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.28);
    border-radius: 12px;
    color: white;
    -unity-font-style: bold;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.startup-disclaimer-button:hover {
    background-color: rgba(163, 224, 255, 0.2);
    border-color: rgba(163, 224, 255, 0.55);
}

.startup-disclaimer-button:active {
    background-color: rgba(120, 209, 255, 0.3);
}

.panel-content {
    width: 700px;
    padding: 30px 34px 28px 34px;
    background-color: rgba(185, 219, 255, 0.19);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    border-top-color: rgba(255, 255, 255, 0.52);
    border-left-color: rgba(255, 255, 255, 0.18);
    border-radius: 24px;
    min-height: 320px;
}

.panel-content--settings {
    width: 760px;
}

.panel-content--credits {
    width: 760px;
}

.panel-header {
    font-size: 34px;
    color: white;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.panel-subtitle {
    font-size: 15px;
    color: rgba(227, 242, 255, 0.82);
    margin-bottom: 24px;
}

.settings-card,
.credits-card {
    background-color: rgba(11, 35, 68, 0.28);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 18px;
    padding: 20px 22px;
}

.setting-block {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 16px 18px;
    margin-bottom: 14px;
}

.setting-block--toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.setting-copy {
    margin-bottom: 14px;
}

.setting-meta-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.setting-meta-label {
    font-size: 12px;
    color: rgba(163, 224, 255, 0.75);
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.setting-meta-value {
    font-size: 17px;
    color: white;
    -unity-font-style: bold;
}

.setting-label {
    font-size: 23px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.setting-description {
    font-size: 14px;
    color: rgba(221, 238, 255, 0.72);
}

.settings-slider {
    margin-top: 6px;
}

.settings-slider .unity-base-slider__tracker {
    height: 8px;
    background-color: rgba(255, 255, 255, 0.16);
    border-radius: 999px;
}

.settings-slider .unity-base-slider__dragger {
    width: 18px;
    height: 18px;
    background-color: #f1fbff;
    border-radius: 999px;
    border-width: 2px;
    border-color: rgba(0, 210, 255, 0.65);
}

.settings-slider .unity-base-slider__dragger-border {
    background-color: transparent;
}

.settings-toggle {
    min-width: 88px;
    margin-left: 18px;
}

.settings-toggle-row {
    flex-direction: row;
    align-items: center;
}

.settings-toggle .unity-toggle__input {
    width: 28px;
    height: 28px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
    border-radius: 6px;
}

.settings-toggle .unity-toggle__checkmark {
    -unity-background-image-tint-color: white;
}

.credits-section {
    background-color: rgba(255, 255, 255, 0.045);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 16px 18px;
    margin-bottom: 14px;
}

.credits-section-title {
    font-size: 14px;
    color: var(--color-primary);
    letter-spacing: 4px;
    -unity-font-style: bold;
    margin-bottom: 14px;
}

.credits-name-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.credits-name {
    font-size: 28px;
    color: white;
    -unity-font-style: bold;
    margin-right: 22px;
    margin-bottom: 10px;
}

.credits-detail {
    font-size: 18px;
    color: rgba(236, 246, 255, 0.86);
}

.panel-footer {
    margin-top: 18px;
    align-items: flex-end;
}

.close-btn {
    min-width: 170px;
    height: 46px;
    padding: 0 24px;
    background-color: rgba(255, 255, 255, 0.09);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.28);
    border-radius: 12px;
    color: white;
    -unity-font-style: bold;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.close-btn:hover {
    background-color: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.42);
}

.close-btn:active {
    background-color: rgba(120, 209, 255, 0.2);
}

.fade-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: white;
    opacity: 0;
    justify-content: center;
    align-items: center;
    display: none;
    transition-property: opacity;
    transition-duration: 1s;
}

.loading-container {
    opacity: 0;
    align-items: center;
    transition-duration: 0.8s;
}

.anomaly-shadow {
    position: absolute;
    left: -200px;
    bottom: 0;
    width: 400px;
    height: 800px;
    background-color: rgba(0, 0, 0, 0.4);
    opacity: 0;
    -unity-background-image-tint-color: black;
}

.anomaly-ghost {
    position: absolute;
    right: 15%;
    top: 20%;
    width: 300px;
    height: 500px;
    background-color: rgba(255, 255, 255, 0.2);
    opacity: 0;
    display: none;
}

.anomaly-popup {
    position: absolute;
    left: 50%;
    top: 20%;
    translate: -50% 0;
    background-color: rgba(0, 20, 40, 0.85);
    border-width: 1px;
    border-color: #00d2ff;
    padding: 15px 30px;
    opacity: 0;
    display: none;
    align-items: center;
}

.anomaly-popup Label {
    color: #00d2ff;
    font-size: 18px;
    letter-spacing: 2px;
}

.anomaly-load {
    position: absolute;
    bottom: 150px;
    left: 50%;
    translate: -50% 0;
    width: 400px;
    opacity: 0;
    display: none;
}

.load-text {
    color: #a3e0ff;
    font-size: 14px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.load-bar-bg {
    height: 4px;
    background-color: rgba(255, 255, 255, 0.1);
    overflow: hidden;
}

.load-bar-fill {
    width: 0;
    height: 100%;
    background-color: #00d2ff;
}

.logo-eye {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 60px;
    height: 80px;
    background-color: white;
    border-radius: 30px;
    opacity: 0;
    display: none;
}

.logo-eye-blink {
    background-color: #00d2ff;
    scale: 1 0.1;
}

.loading-text {
    font-size: 11px;
    color: #008eb0;
    letter-spacing: 10px;
    margin-top: 25px;
    -unity-font-style: bold;
    opacity: 0.5;
}

.loading-spinner {
    width: 32px;
    height: 32px;
    border-width: 2px;
    border-color: rgba(0, 142, 176, 0.05);
    border-top-color: #00d2ff;
    border-radius: 16px;
}
