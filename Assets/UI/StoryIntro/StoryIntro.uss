.root {
    flex-grow: 1;
    background-color: black;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.story-text {
    color: white;
    font-size: 50px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 15px rgba(0, 160, 255, 0.6);
    white-space: normal;
    -unity-font-style: bold;
}

.glitch-text {
    position: absolute;
    display: none;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
}

.glitch-text.r {
    color: rgba(255, 50, 50, 0.8);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.glitch-text.b {
    color: rgba(50, 255, 255, 0.8);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}
