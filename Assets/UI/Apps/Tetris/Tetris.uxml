<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Tetris.uss" />
    <ui:VisualElement name="tetris-window" class="tetris-window hidden">
        <ui:VisualElement class="window-title-bar">
            <ui:Label text="Aero Tetris" class="window-title" />
            <ui:Button name="close-button" text="X" class="close-button" />
        </ui:VisualElement>
        
        <ui:VisualElement class="tetris-content">
            <ui:VisualElement name="tetris-board-container" class="tetris-board-container">
                <ui:VisualElement name="tetris-board" class="tetris-board" />
                <ui:VisualElement name="game-over-overlay" class="game-over-overlay hidden">
                    <ui:Label text="GAME OVER" class="game-over-title" />
                    <ui:VisualElement name="name-input-section" class="name-input-section">
                        <ui:Label text="NEW HIGH SCORE!" class="high-score-alert" />
                        <ui:TextField name="name-input" label="NAME" class="name-field" />
                        <ui:Button name="submit-name-button" text="SUBMIT" class="submit-button" />
                    </ui:VisualElement>
                    <ui:Button name="restart-button" text="RESTART" class="restart-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <ui:VisualElement class="tetris-side-panel">
                <ui:VisualElement class="stat-container">
                    <ui:Label text="SCORE" class="stat-label" />
                    <ui:Label name="score-label" text="000000" class="stat-value" />
                </ui:VisualElement>
                
                <ui:VisualElement class="stat-container">
                    <ui:Label text="LEVEL" class="stat-label" />
                    <ui:Label name="level-label" text="1" class="stat-value" />
                </ui:VisualElement>

                <ui:VisualElement class="stat-container">
                    <ui:Label text="LINES" class="stat-label" />
                    <ui:Label name="lines-label" text="0" class="stat-value" />
                </ui:VisualElement>

                <ui:VisualElement class="stat-container">
                    <ui:Label text="NEXT" class="stat-label" />
                    <ui:VisualElement name="next-piece-preview" class="next-piece-preview" />
                </ui:VisualElement>

                <ui:VisualElement class="high-score-container">
                    <ui:Label text="HIGH SCORES" class="stat-label" />
                    <ui:VisualElement name="high-score-list" class="high-score-list" />
                </ui:VisualElement>

                <ui:VisualElement style="flex-grow: 1;" />
                <ui:Label name="bonus-status-label" text="Clear 5 lines to recover a hidden shard." class="bonus-status-label" />
                <ui:Label text="WASD / ARROWS to Move" style="color: rgba(255,255,255,0.5); font-size: 10px;" />
                <ui:Label text="W / UP to Rotate" style="color: rgba(255,255,255,0.5); font-size: 10px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
