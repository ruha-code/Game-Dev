:root {
    --tetris-bg: rgba(200, 240, 255, 0.15);
    --glass-border: rgba(255, 255, 255, 0.5);
    --glass-highlight: rgba(255, 255, 255, 0.8);
    --tetris-grid-bg: rgba(0, 0, 0, 0.4);
}

.tetris-window {
    position: absolute;
    width: 500px;
    height: 700px;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background-color: var(--tetris-bg);
    border-width: 2px;
    border-color: var(--glass-highlight);
    border-radius: 12px;
    padding: 10px;
}

.window-title-bar {
    height: 40px;
    flex-direction: row;
    align-items: center;
    padding: 0 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--glass-border);
    margin-bottom: 10px;
}

.window-title {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.close-button {
    width: 24px;
    height: 24px;
    background-color: #d04040;
    border-radius: 4px;
    color: white;
    -unity-text-align: middle-center;
}

.close-button:hover {
    background-color: #f05050;
}

.tetris-content {
    flex-grow: 1;
    flex-direction: row;
}

.tetris-board {
    width: 300px;
    height: 600px;
    background-color: var(--tetris-grid-bg);
    border-width: 1px;
    border-color: var(--glass-border);
    position: relative;
    overflow: hidden;
}

.tetris-side-panel {
    flex-grow: 1;
    padding: 0 15px;
    justify-content: flex-start;
}

.stat-container {
    margin-bottom: 20px;
}

.stat-label {
    color: #e0f0ff;
    font-size: 14px;
    margin-bottom: 5px;
}

.stat-value {
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
}

.next-piece-preview {
    width: 100px;
    height: 100px;
    background-color: rgba(0, 0, 0, 0.2);
    border-width: 1px;
    border-color: var(--glass-border);
    margin-top: 10px;
}

.tetris-block {
    position: absolute;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

.hidden {
    display: none;
}
