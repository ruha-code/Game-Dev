This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
:root {
    --tetris-bg: rgba(200, 240, 255, 0.85);
    --glass-border: rgba(255, 255, 255, 0.7);
    --glass-highlight: rgba(255, 255, 255, 0.9);
    --tetris-grid-bg: rgba(0, 0, 0, 0.75);
}

.tetris-window {
    position: absolute;
    width: 500px;
    height: 700px;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background-color: var(--tetris-bg);
    border-width: 2px;
    border-color: var(--glass-highlight);
    border-radius: 12px;
    padding: 10px;
    overflow: hidden;
}

.window-title-bar {
    height: 40px;
    flex-direction: row;
    align-items: center;
    padding: 0 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--glass-border);
    margin-bottom: 10px;
}

.window-title {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.close-button {
    width: 24px;
    height: 24px;
    background-color: #d04040;
    border-radius: 4px;
    color: white;
    -unity-text-align: middle-center;
}

.close-button:hover {
    background-color: #f05050;
}

.tetris-content {
    flex-grow: 1;
    flex-direction: row;
}

.tetris-board-container {
    width: 300px;
    height: 600px;
    position: relative;
}

.tetris-board {
    width: 100%;
    height: 100%;
    background-color: var(--tetris-grid-bg);
    border-width: 1px;
    border-color: var(--glass-border);
    position: absolute;
    overflow: hidden;
}

.game-over-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.fragment-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 16, 24, 0.88);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 28px;
    opacity: 0;
}

.fragment-overlay--visible {
    opacity: 1;
}

.fragment-panel {
    width: 100%;
    max-width: 320px;
    align-items: center;
    justify-content: center;
    padding: 26px 24px;
    background-color: rgba(9, 17, 26, 0.82);
    border-width: 1px;
    border-color: rgba(143, 252, 255, 0.35);
    border-radius: 10px;
}

.fragment-title {
    color: #8ffcff;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 250px;
    margin-bottom: 16px;
    text-shadow: 0 0 12px rgba(110, 255, 255, 0.75);
}

.fragment-body {
    color: rgba(230, 248, 255, 0.94);
    font-size: 15px;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 240px;
}

.game-over-title {
    color: #ff4040;
    font-size: 32px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    text-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
}

.name-input-section {
    align-items: center;
    width: 100%;
}

.high-score-alert {
    color: #ffd700;
    font-size: 18px;
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.name-field {
    width: 200px;
    margin-bottom: 10px;
}

.name-field #unity-text-input {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: white;
    color: white;
}

.submit-button {
    background-color: #0088ff;
    color: white;
    padding: 8px 16px;
    border-radius: 4px;
    margin-top: 10px;
}

.restart-button {
    background-color: #404040;
    color: white;
    padding: 8px 16px;
    border-radius: 4px;
    margin-top: 15px;
}

.restart-button:hover {
    background-color: #606060;
}

.high-score-container {
    margin-top: 15px;
    flex-grow: 1;
}

.high-score-list {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    padding: 5px;
}

.high-score-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.high-score-rank {
    width: 20px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
}

.high-score-name {
    flex-grow: 1;
    color: white;
    font-size: 12px;
}

.high-score-score {
    color: #8ffcff;
    font-size: 12px;
    -unity-font-style: bold;
}

.tetris-side-panel {
    flex-grow: 1;
    padding: 0 15px;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 8px;
    margin-left: 5px;
}

.stat-container {
    margin-bottom: 20px;
}

.stat-label {
    color: #8ffcff;
    font-size: 14px;
    margin-bottom: 5px;
    -unity-font-style: bold;
}

.stat-value {
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
}

.bonus-status-label {
    color: #e0f0ff;
    font-size: 11px;
    white-space: normal;
    margin-bottom: 12px;
}

.next-piece-preview {
    width: 100px;
    height: 100px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: var(--glass-border);
    margin-top: 10px;
}

.control-hint {
    color: #e0f0ff;
    font-size: 10px;
    -unity-font-style: bold;
}

.tetris-block {
    position: absolute;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

.ghost-block {
    opacity: 0.35;
}

.hidden {
    display: none;
}
