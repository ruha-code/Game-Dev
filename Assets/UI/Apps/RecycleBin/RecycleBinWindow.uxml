<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="RecycleBinWindow.uss" />
    <ui:VisualElement name="recycle-bin-window" class="recycle-bin-window hidden">
        <ui:VisualElement class="scanline-overlay" />
        <ui:VisualElement class="digital-fog" />
        
        <ui:VisualElement class="recycle-bin-window-header">
            <ui:VisualElement class="recycle-bin-window-title-block">
                <ui:Label name="recycle-bin-window-title" text="Recycle Bin" class="recycle-bin-window-title" />
                <ui:Label text="Memory Residue Recovery Shell" class="recycle-bin-window-subtitle" />
            </ui:VisualElement>
            <ui:Button name="recycle-bin-close-button" text="X" class="recycle-bin-close-button" />
        </ui:VisualElement>

        <ui:VisualElement class="recycle-bin-window-shell">
            <ui:VisualElement class="recycle-bin-main-layout">
                <ui:VisualElement name="bin-void" class="bin-void">
                    <ui:Label name="void-status-text" text="AWAITING INPUT..." class="void-status-text" />
                    
                    <ui:VisualElement name="sentence-container" class="sentence-container hidden" />

                    <ui:VisualElement name="fragment-spawn-area" class="fragment-spawn-area" />
                    
                    <ui:VisualElement name="engineer-selection" class="engineer-selection">
                        <ui:Button name="engineer-btn-0" class="engineer-sphere-btn">
                            <ui:VisualElement class="sphere-icon sphere-icon--botanist" />
                            <ui:Label text="CHARACTER 1" class="sphere-label" />
                        </ui:Button>
                        <ui:Button name="engineer-btn-1" class="engineer-sphere-btn">
                            <ui:VisualElement class="sphere-icon sphere-icon--loop" />
                            <ui:Label text="CHARACTER 2" class="sphere-label" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="reconstruction-bar-container">
                    <ui:Label text="RECONSTRUCTION SEQUENCE" class="reconstruction-bar-label" />
                    <ui:VisualElement name="reconstruction-area" class="reconstruction-bar" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="reconstruction-sidebar">
                <ui:Label text="DIAGNOSTICS" class="reconstruction-title" />
                <ui:Label name="reconstruction-integrity" text="INTEGRITY: 100%" class="reconstruction-integrity" />
                
                <ui:VisualElement class="corruption-meter-container">
                    <ui:Label text="SYSTEM CORRUPTION" class="meter-label" />
                    <ui:VisualElement class="meter-bg">
                        <ui:VisualElement name="corruption-fill" class="meter-fill" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="engineer-info" class="engineer-info-card hidden">
                    <ui:Label name="info-name" text="Unknown" class="info-name" />
                    <ui:Label name="info-role" text="Unknown Role" class="info-role" />
                    <ui:Label text="DELETED" class="info-status" />
                </ui:VisualElement>

                <ui:VisualElement class="bin-instructions">
                    <ui:Label text="Filter noise fragments." class="instruction-line" />
                    <ui:Label text="Sequence valid residue." class="instruction-line" />
                    <ui:Label text="Click reconstruction items to undo." class="instruction-line" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="recycle-bin-completion-popup" class="recycle-bin-completion-popup hidden">
            <ui:Label text="ARCHIVE RESTORED" class="recycle-bin-completion-title" />
            <ui:Label name="recycle-bin-final-summary" text="The memory fragments have been reassembled. The truth is surfacing." class="recycle-bin-completion-body" />
            <ui:Button name="recycle-bin-complete-button" text="Return to Desktop" class="recycle-bin-complete-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>