:root {
    --bin-void-color: #04080f;
    --bin-glass: rgba(15, 32, 54, 0.6);
    --bin-glow: #7af8ff;
    --bin-warn: #ff4d6a;
    --bin-text: #f0faff;
    --bin-accent: #9fd6ff;
    --bin-subtle: rgba(159, 214, 255, 0.5);
}

.recycle-bin-window {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--bin-void-color);
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(122, 248, 255, 0.2);
    border-radius: 12px;
}

.scanline-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.1);
    opacity: 0.15;
}

.digital-fog {
    position: absolute;
    width: 200%;
    height: 200%;
    background-color: rgba(122, 248, 255, 0.03);
    border-radius: 1000px;
    translate: -25% -25%;
}

.recycle-bin-window-header {
    height: 58px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px 0 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.08);
}

.recycle-bin-window-title {
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    text-shadow: 0 0 8px rgba(122, 248, 255, 0.8);
}

.recycle-bin-window-subtitle {
    color: var(--bin-subtle);
    font-size: 11px;
    letter-spacing: 1px;
}

.recycle-bin-close-button {
    width: 28px;
    height: 24px;
    background-color: rgba(214, 68, 68, 0.9);
    border-radius: 6px;
    color: white;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.recycle-bin-window-shell {
    flex-grow: 1;
    flex-direction: row;
}

.recycle-bin-main-layout {
    flex-grow: 1;
}

.bin-void {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgba(0, 5, 10, 0.5);
    justify-content: center;
    align-items: center;
}

.void-status-text {
    position: absolute;
    top: 30px;
    color: var(--bin-glow);
    font-size: 16px;
    letter-spacing: 4px;
    opacity: 0.4;
    -unity-font-style: bold;
}

.fragment-spawn-area {
    position: absolute;
    width: 100%;
    height: 100%;
}

.sentence-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding: 60px;
    max-width: 800px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(122, 248, 255, 0.1);
}

.sentence-word {
    color: white;
    font-size: 20px;
    margin-right: 8px;
    margin-bottom: 12px;
}

.sentence-slot {
    min-width: 100px;
    height: 34px;
    border-width: 1px;
    border-bottom-width: 2px;
    border-color: var(--bin-glow);
    background-color: rgba(122, 248, 255, 0.05);
    border-radius: 6px;
    margin-right: 8px;
    margin-bottom: 12px;
    justify-content: center;
    align-items: center;
    transition-duration: 0.2s;
}

.sentence-slot:hover {
    background-color: rgba(122, 248, 255, 0.1);
}

.sentence-slot--filled {
    background-color: rgba(122, 248, 255, 0.15);
    border-color: white;
}

.sentence-slot-label {
    color: var(--bin-glow);
    font-size: 16px;
    -unity-font-style: bold;
}

.reconstruction-bar-container {
    height: 120px;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 1px;
    border-top-color: rgba(122, 248, 255, 0.2);
    padding: 10px 20px;
}

.reconstruction-bar-label {
    color: var(--bin-accent);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 8px;
    opacity: 0.7;
}

.reconstruction-bar {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
}

.engineer-selection {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    transition-duration: 0.5s;
    transition-property: opacity, translate;
}

.engineer-sphere-btn {
    width: 200px;
    height: 260px;
    margin: 15px;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    align-items: center;
}

.sphere-icon {
    width: 160px;
    height: 160px;
    border-radius: 80px;
    background-color: var(--bin-glass);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    margin-bottom: 20px;
    justify-content: center;
    align-items: center;
}

.sphere-icon--botanist { background-color: rgba(134, 235, 181, 0.15); border-color: #86ebb5; }
.sphere-icon--loop { background-color: rgba(132, 213, 255, 0.15); border-color: #84d5ff; }
.sphere-icon--process { background-color: rgba(255, 127, 149, 0.15); border-color: #ff7f95; }

.sphere-label {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.reconstruction-sidebar {
    width: 300px;
    background-color: rgba(7, 17, 31, 0.95);
    border-left-width: 1px;
    border-left-color: rgba(122, 248, 255, 0.2);
    padding: 24px;
}

.reconstruction-title {
    color: var(--bin-accent);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.reconstruction-integrity {
    color: var(--bin-glow);
    font-size: 11px;
    margin-bottom: 20px;
}

.corruption-meter-container {
    margin-bottom: 24px;
}

.meter-label {
    color: var(--bin-warn);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.meter-bg {
    height: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    overflow: hidden;
}

.meter-fill {
    width: 0%;
    height: 100%;
    background-color: var(--bin-warn);
}

.engineer-info-card {
    padding: 20px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 20px;
}

.info-name { color: white; font-size: 18px; -unity-font-style: bold; margin-bottom: 4px; }
.info-role { color: var(--bin-subtle); font-size: 12px; margin-bottom: 12px; }
.info-status { 
    padding: 4px 10px;
    background-color: var(--bin-warn);
    border-radius: 6px;
    color: white;
    font-size: 10px;
    -unity-font-style: bold;
    align-self: flex-start;
}

.bin-instructions {
    margin-top: auto;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.05);
    padding-top: 15px;
}

.instruction-line {
    color: var(--bin-subtle);
    font-size: 10px;
    margin-bottom: 5px;
    -unity-font-style: italic;
}

.memory-fragment {
    position: absolute;
    padding: 10px 20px;
    background-color: var(--bin-glass);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 16px;
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
}

.memory-fragment--virus {
    border-color: rgba(255, 255, 255, 0.25);
}

.memory-fragment--placed {
    position: relative;
    margin-right: 10px;
    border-color: var(--bin-glow);
    background-color: rgba(122, 248, 255, 0.1);
    left: auto;
    top: auto;
}

.hidden { display: none; }

.terminal-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: #020408;
    padding: 100px;
    justify-content: center;
    align-items: center;
    transition-duration: 1s;
    transition-property: opacity;
}

.terminal-content {
    width: 100%;
    max-width: 800px;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.terminal-scroll {
    flex-grow: 1;
    width: 100%;
}

.terminal-text {
    color: var(--bin-glow);
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
    letter-spacing: 1px;
}

.terminal-continue-button {
    margin-top: 40px;
    background-color: transparent;
    border-width: 1px;
    border-color: var(--bin-glow);
    color: var(--bin-glow);
    padding: 12px 40px;
    border-radius: 4px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.terminal-continue-button:hover {
    background-color: var(--bin-glow);
    color: black;
}

.recycle-bin-completion-popup {
position: absolute;
    width: 480px;
    left: 50%; top: 50%; translate: -50% -50%;
    padding: 40px;
    background-color: rgba(8, 16, 32, 0.98);
    border-width: 2px;
    border-color: var(--bin-glow);
    border-radius: 24px;
    align-items: center;
}

.recycle-bin-completion-title { color: white; font-size: 26px; -unity-font-style: bold; margin-bottom: 12px; }
.recycle-bin-completion-body { color: #ddf3ff; font-size: 15px; -unity-text-align: middle-center; white-space: normal; margin-bottom: 24px; }
.recycle-bin-complete-button { 
    width: 200px; height: 40px; border-radius: 12px; 
    background-color: var(--bin-glow); color: black; -unity-font-style: bold; 
    border-width: 0;
}

.glitch-text {
    color: var(--bin-warn);
}