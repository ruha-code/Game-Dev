:root {
    --docs-border-glow: rgba(123, 241, 255, 0.72);
    --docs-glass: rgba(199, 236, 255, 0.17);
    --docs-panel: rgba(9, 24, 48, 0.66);
    --docs-panel-strong: rgba(8, 20, 40, 0.82);
    --docs-subtle: rgba(220, 241, 255, 0.82);
    --docs-text: #eff9ff;
    --docs-accent: #95efff;
    --docs-success: rgba(116, 224, 184, 0.22);
    --docs-danger: rgba(181, 36, 52, 0.16);
    --docs-danger-line: rgba(255, 72, 92, 0.72);
    --docs-shadow: rgba(0, 18, 36, 0.55);
}

.documents-window {
    position: absolute;
    width: 1140px;
    height: 760px;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background-color: rgba(8, 23, 46, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 22px;
    overflow: hidden;
}

.documents-window--glitch {
    border-color: rgba(255, 110, 110, 0.85);
}

.documents-wallpaper-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.28;
    background-image: url("project://database/Assets/Image/WallpaperV2.png");
    -unity-background-scale-mode: scale-and-crop;
}

.documents-window-tint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 18, 34, 0.56);
}

.documents-particle {
    position: absolute;
    border-radius: 999px;
    background-color: rgba(170, 242, 255, 0.16);
}

.documents-particle--one {
    width: 180px;
    height: 180px;
    right: 240px;
    top: 54px;
}

.documents-particle--two {
    width: 110px;
    height: 110px;
    right: 130px;
    top: 170px;
}

.documents-particle--three {
    width: 90px;
    height: 90px;
    left: 260px;
    bottom: 86px;
}

.documents-window-header {
    height: 58px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px 0 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.16);
    background-color: rgba(255, 255, 255, 0.11);
}

.documents-window-title-block {
    justify-content: center;
}

.documents-window-title {
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
}

.documents-window-subtitle {
    color: rgba(233, 247, 255, 0.74);
    font-size: 12px;
}

.documents-close-button {
    width: 28px;
    height: 24px;
    background-color: rgba(214, 68, 68, 0.96);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
    border-radius: 6px;
    color: white;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.documents-window-shell {
    position: absolute;
    left: 0;
    right: 0;
    top: 58px;
    bottom: 0;
    flex-direction: row;
    padding: 16px;
}

.documents-column {
    background-color: var(--docs-glass);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.26);
    border-radius: 20px;
    padding: 18px;
}

.documents-column--main {
    flex-grow: 1;
    margin-right: 16px;
}

.documents-column--side {
    width: 270px;
    justify-content: flex-start;
}

.documents-report-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.documents-toolbar-slot {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
}

.documents-toolbar-slot--left {
    justify-content: flex-start;
}

.documents-toolbar-slot--center {
    justify-content: center;
}

.documents-toolbar-slot--right {
    justify-content: flex-end;
}

.documents-toolbar-slot .documents-section-title {
    white-space: nowrap;
}

.documents-toolbar-left {
    flex-grow: 1;
    justify-content: center;
}

.documents-toolbar-right {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
}

.documents-section-title {
    color: var(--docs-accent);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.documents-mode-badge,
.documents-anomaly-label {
    min-height: 28px;
    padding: 6px 14px;
    border-radius: 12px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    max-width: 180px;
}

.documents-mode-badge {
    min-width: 138px;
    background-color: rgba(5, 34, 68, 0.62);
    border-width: 1px;
    border-color: rgba(152, 236, 255, 0.24);
    color: #b4f2ff;
}

.documents-anomaly-label {
    min-width: 152px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(236, 247, 255, 0.92);
}

.documents-anomaly-label--warning {
    background-color: rgba(161, 31, 31, 0.6);
    color: #fff0f0;
}

.documents-intro-text {
    color: var(--docs-subtle);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 12px;
}

.documents-page {
    flex-grow: 1;
    background-color: rgba(252, 254, 255, 0.95);
    border-radius: 18px;
    padding: 18px;
    border-width: 1px;
    border-color: rgba(164, 212, 240, 0.42);
    margin-bottom: 14px;
}

.documents-page-header {
    margin-bottom: 12px;
}

.documents-page-stamp {
    color: #4a6786;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.documents-page-metadata {
    color: rgba(54, 73, 98, 0.84);
    font-size: 11px;
}

.documents-page-text {
    color: #24354c;
    font-size: 19px;
    line-height: 27px;
    white-space: normal;
    margin-bottom: 18px;
}

.documents-blanks-layer {
    margin-bottom: 18px;
}

.documents-blank {
    min-height: 94px;
    margin-bottom: 10px;
    padding: 12px 14px 10px 14px;
    background-color: rgba(16, 35, 65, 0.05);
    border-width: 1px;
    border-color: rgba(50, 82, 122, 0.16);
    border-radius: 14px;
    -unity-text-align: upper-left;
}

.documents-blank:hover {
    background-color: rgba(97, 222, 255, 0.1);
    border-color: rgba(97, 222, 255, 0.4);
}

.documents-blank-field {
    color: rgba(46, 68, 97, 0.75);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.documents-blank-text {
    color: #1e2f46;
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.documents-blank-caption {
    color: rgba(49, 72, 101, 0.76);
    font-size: 12px;
    margin-bottom: 8px;
}

.documents-scan-track {
    width: 100%;
    height: 7px;
    background-color: rgba(20, 42, 72, 0.08);
    border-radius: 999px;
    overflow: hidden;
}

.documents-scan-fill {
    height: 100%;
    width: 0;
    background-color: linear-gradient(to right, rgba(116, 207, 255, 0.74), rgba(75, 121, 255, 0.84));
}

.documents-blank--selected {
    border-color: rgba(82, 167, 255, 0.78);
    background-color: rgba(70, 156, 255, 0.09);
    box-shadow: 0 0 0 2px rgba(114, 184, 255, 0.2);
}

.documents-blank--scanned {
    border-color: rgba(128, 232, 255, 0.62);
}

.documents-blank--restored {
    border-color: rgba(118, 228, 188, 0.78);
    background-color: rgba(116, 224, 184, 0.16);
    box-shadow: 0 0 0 2px rgba(118, 228, 188, 0.14);
}

.documents-blank--restored .documents-blank-text {
    color: #186057;
}

.documents-blank--error {
    background-color: var(--docs-danger);
    border-color: rgba(214, 78, 88, 0.44);
}

.documents-lie-panel {
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(17, 42, 68, 0.1);
}

.documents-lie-title {
    color: #485f82;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 10px;
}

.documents-lie-line {
    color: #2d3f59;
    font-size: 15px;
    white-space: normal;
    margin-bottom: 8px;
    padding: 10px 12px 12px 12px;
    background-color: rgba(16, 30, 52, 0.04);
    border-width: 1px;
    border-color: rgba(36, 57, 86, 0.08);
    border-radius: 12px;
}

.documents-lie-line--false {
    border-bottom-width: 2px;
    border-bottom-color: var(--docs-danger-line);
}

.documents-lie-line--hover {
    background-color: rgba(97, 222, 255, 0.08);
    border-color: rgba(76, 168, 212, 0.18);
}

.documents-lie-line--exposed {
    color: #7f222b;
    -unity-font-style: bold;
    background-color: rgba(186, 60, 72, 0.08);
    border-color: rgba(186, 60, 72, 0.18);
    border-bottom-color: rgba(186, 60, 72, 0.42);
}

.documents-status-bar {
    min-height: 78px;
    flex-direction: column;
    justify-content: center;
    background-color: rgba(10, 28, 52, 0.7);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    padding: 10px;
    overflow: hidden;
}

.documents-status-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    width: 100%;
    flex-shrink: 0;
}

.documents-status-row--full {
    margin-bottom: 0;
}

.documents-status-pill {
    min-height: 36px;
    margin-right: 8px;
    padding: 8px 12px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.08);
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    white-space: nowrap;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.documents-status-pill--compact {
    flex-shrink: 0;
}

.documents-status-pill--wide {
    flex-grow: 1;
    white-space: normal;
    margin-right: 0;
    width: auto;
    border-radius: 10px;
    -unity-text-align: middle-left;
}

.documents-side-card {
    background-color: var(--docs-panel);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 14px;
    margin-bottom: 14px;
    overflow: hidden;
}

.documents-side-card--wordbank {
    padding-bottom: 10px;
}

.documents-side-card--target {
    margin-bottom: 0;
}

.documents-side-description {
    color: rgba(218, 239, 255, 0.76);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 8px;
}

.documents-recommendation {
    margin-bottom: 12px;
    padding: 8px 10px;
    min-height: 36px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(236, 247, 255, 0.88);
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: upper-left;
}

.documents-recommendation--warning {
    background-color: rgba(161, 31, 31, 0.22);
    border-width: 1px;
    border-color: rgba(255, 110, 120, 0.3);
}

.documents-word-bank {
    flex-direction: column;
}

.documents-word-button {
    min-height: 32px;
    margin-bottom: 5px;
    padding: 6px 8px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 14px;
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.documents-word-button:hover {
    background-color: rgba(117, 222, 255, 0.18);
}

.documents-word-button--recommended {
    border-color: rgba(255, 99, 110, 0.32);
    color: #ffd6db;
}

.documents-word-button--signal {
    border-color: rgba(135, 228, 255, 0.28);
}

.documents-word-button--used {
    opacity: 0.42;
}

.documents-focus-title {
    color: #b7f5ff;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.documents-focus-line {
    color: rgba(245, 251, 255, 0.92);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 8px;
}

.documents-focus-line--hint {
    color: rgba(189, 239, 255, 0.84);
}

.documents-focus-summary {
    margin-top: 4px;
    color: rgba(220, 241, 255, 0.76);
    font-size: 11px;
    white-space: normal;
}

.documents-completion-popup {
    position: absolute;
    width: 420px;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    padding: 24px 22px 20px 22px;
    background-color: rgba(8, 24, 46, 0.96);
    border-width: 1px;
    border-color: rgba(135, 228, 255, 0.48);
    border-radius: 22px;
}

.documents-completion-glow {
    position: absolute;
    left: -40px;
    top: -40px;
    width: 200px;
    height: 200px;
    border-radius: 999px;
    background-color: rgba(120, 225, 255, 0.12);
}

.documents-completion-title {
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.documents-completion-body {
    color: rgba(223, 244, 255, 0.92);
    font-size: 15px;
    white-space: normal;
    margin-bottom: 18px;
}

.documents-continue-button {
    min-height: 42px;
    background-color: rgba(112, 201, 255, 0.22);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.24);
    border-radius: 14px;
    color: white;
    -unity-font-style: bold;
}

.hidden {
    display: none;
}
