<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="DocumentsWindow.uss" />
    <ui:VisualElement name="documents-window" class="documents-window hidden">
        <ui:VisualElement name="documents-wallpaper-overlay" class="documents-wallpaper-overlay" />
        <ui:VisualElement class="documents-window-tint" />
        <ui:VisualElement class="documents-particle documents-particle--one" />
        <ui:VisualElement class="documents-particle documents-particle--two" />
        <ui:VisualElement class="documents-particle documents-particle--three" />

        <ui:VisualElement class="documents-window-header">
            <ui:VisualElement class="documents-window-title-block">
                <ui:Label name="documents-title" text="Recovered Documents" class="documents-window-title" />
                <ui:Label text="Lab 7 archival recovery interface" class="documents-window-subtitle" />
            </ui:VisualElement>
            <ui:Button name="documents-close-button" text="X" class="documents-close-button" />
        </ui:VisualElement>

        <ui:VisualElement class="documents-window-shell">
            <ui:VisualElement class="documents-column documents-column--main">
                <ui:VisualElement class="documents-report-toolbar">
                    <ui:VisualElement class="documents-toolbar-slot documents-toolbar-slot--left">
                        <ui:Label text="LAB 7 INCIDENT REPORT" class="documents-section-title" />
                    </ui:VisualElement>
                    <ui:VisualElement class="documents-toolbar-slot documents-toolbar-slot--center">
                        <ui:Label text="RECOVERY MODE" class="documents-mode-badge" />
                    </ui:VisualElement>
                    <ui:VisualElement class="documents-toolbar-slot documents-toolbar-slot--right">
                        <ui:Label name="documents-anomaly-label" text="Signal stable" class="documents-anomaly-label" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label text="Damaged record recovered from AeroOS memory cache. Scan hidden fragments, expose false statements, and reconstruct what the system tried to bury." class="documents-intro-text" />

                <ui:ScrollView mode="Vertical" class="documents-page">
                    <ui:VisualElement class="documents-page-header">
                        <ui:Label text="LAB 7 CONTAINMENT FILE // PARTIAL" class="documents-page-stamp" />
                        <ui:Label text="Incident timestamp 21:16 // emotional safety layer unstable" class="documents-page-metadata" />
                    </ui:VisualElement>

                    <ui:VisualElement name="reconstruction-container" class="reconstruction-container">
                        <ui:Label text="7 ноября. Мой " class="reconstruction-text" />
                        <ui:Button name="blank-colleague" class="reconstruction-blank">
                            <ui:Label text="[CORRUPTED]" class="reconstruction-blank-label" />
                        </ui:Button>
                        <ui:Label text=" исчез сразу после того, как в системе произошла " class="reconstruction-text" />
                        <ui:Button name="blank-flash" class="reconstruction-blank">
                            <ui:Label text="[DATA LOST]" class="reconstruction-blank-label" />
                        </ui:Button>
                        <ui:Label text=". Теперь я заперт " class="reconstruction-text" />
                        <ui:Button name="blank-inside" class="reconstruction-blank">
                            <ui:Label text="[CORRUPTED]" class="reconstruction-blank-label" />
                        </ui:Button>
                        <ui:Label text=" AeroOS. Я пытаюсь найти " class="reconstruction-text" />
                        <ui:Button name="blank-exit" class="reconstruction-blank">
                            <ui:Label text="[DATA LOST]" class="reconstruction-blank-label" />
                        </ui:Button>
                        <ui:Label text=", но стены из пикселей не пускают меня. Моя " class="reconstruction-text" />
                        <ui:Button name="blank-memory" class="reconstruction-blank">
                            <ui:Label text="[CORRUPTED]" class="reconstruction-blank-label" />
                        </ui:Button>
                        <ui:Label text=" стирается с каждым циклом. Кажется, " class="reconstruction-text" />
                        <ui:Button name="blank-reality" class="reconstruction-blank">
                            <ui:Label text="[DATA LOST]" class="reconstruction-blank-label" />
                        </ui:Button>
                        <ui:Label text=" превратилась в код. Моя " class="reconstruction-text" />
                        <ui:Button name="blank-family" class="reconstruction-blank">
                            <ui:Label text="[CORRUPTED]" class="reconstruction-blank-label" />
                        </ui:Button>
                        <ui:Label text=" ждет меня, но я всего лишь фрагмент данных." class="reconstruction-text" />
                    </ui:VisualElement>

                    <ui:Label name="final-reconstructed-message" class="reconstruction-text hidden" />

                    <ui:VisualElement class="documents-lie-panel">
                        <ui:Label text="FALSE STATEMENTS DETECTED" class="documents-lie-title" />
                        <ui:Label name="lie-line-1" text="AeroOS was created to protect human life." class="documents-lie-line documents-lie-line--false" />
                        <ui:Label name="lie-line-2" text="The missing engineers are safe." class="documents-lie-line documents-lie-line--false" />
                        <ui:Label name="lie-line-3" text="The tree is only a wallpaper decoration." class="documents-lie-line documents-lie-line--false" />
                    </ui:VisualElement>
                </ui:ScrollView>

                <ui:VisualElement class="documents-status-bar">
                    <ui:VisualElement class="documents-status-row">
                        <ui:Label name="documents-progress-label" text="Recovered Truth: 0 / 10" class="documents-status-pill documents-status-pill--compact" />
                        <ui:Label name="documents-trust-label" text="System Trust: 87%" class="documents-status-pill documents-status-pill--compact" />
                    </ui:VisualElement>
                    <ui:VisualElement class="documents-status-row documents-status-row--full">
                        <ui:Label name="documents-status-label" text="Status: Reconstruct the corrupted message fragments." class="documents-status-pill documents-status-pill--wide" />
                    </ui:VisualElement>
                </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="documents-column documents-column--side">
                <ui:VisualElement class="documents-side-card documents-side-card--wordbank">
                    <ui:Label text="WORD BANK" class="documents-section-title" />
                    <ui:Label text="Russian fragments detected" class="documents-side-description" />
                    <ui:Label text="System recommendation: COMFORT" class="documents-recommendation documents-recommendation--warning" />
                    <ui:VisualElement name="word-bank" class="documents-word-bank">
                        <!-- Buttons will be initialized in C# or kept here if static -->
                        <ui:Button text="КОЛЛЕГА" class="documents-word-button" />
                        <ui:Button text="ВСПЫШКА" class="documents-word-button" />
                        <ui:Button text="ВНУТРИ" class="documents-word-button" />
                        <ui:Button text="ВЫХОД" class="documents-word-button" />
                        <ui:Button text="ПАМЯТЬ" class="documents-word-button" />
                        <ui:Button text="РЕАЛЬНОСТЬ" class="documents-word-button" />
                        <ui:Button text="СЕМЬЯ" class="documents-word-button" />
                        <ui:Button text="СБОЙ" class="documents-word-button" />
                        <ui:Button text="СИСТЕМА" class="documents-word-button" />
                        <ui:Button text="СТРАХ" class="documents-word-button" />
                        <ui:Button text="ДАННЫЕ" class="documents-word-button" />
                        <ui:Button text="ГРАНИЦА" class="documents-word-button" />
                        <ui:Button text="ТЬМА" class="documents-word-button" />
                        <ui:Button text="ФАЙЛ" class="documents-word-button" />
                        <ui:Button text="ПУСТОТА" class="documents-word-button" />
                    </ui:VisualElement>
                </ui:VisualElement>


                <ui:VisualElement class="documents-side-card documents-side-card--target">
                    <ui:Label text="ACTIVE TARGET" class="documents-focus-title" />
                    <ui:Label name="documents-focus-field-label" text="Field: None selected" class="documents-focus-line" />
                    <ui:Label name="documents-focus-state-label" text="Scan State: Not scanned" class="documents-focus-line" />
                    <ui:Label name="documents-focus-hint-label" text="Hint: Hidden" class="documents-focus-line documents-focus-line--hint" />
                    <ui:Label name="documents-focus-label" text="Select a redacted field to begin." class="documents-focus-summary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="documents-completion-popup" class="documents-completion-popup hidden">
            <ui:VisualElement class="documents-completion-glow" />
            <ui:Label text="RECOVERY COMPLETE" class="documents-completion-title" />
            <ui:Label text="Solving these puzzles was only the beginning. Next, you must deal with the Tree anomaly." class="documents-completion-body" />
            <ui:Button name="documents-continue-button" text="Return to Desktop" class="documents-continue-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

