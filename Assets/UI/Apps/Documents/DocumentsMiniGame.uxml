<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="DocumentsMiniGame.uss" />
    <ui:VisualElement name="documents-root" class="documents-root">
        <ui:VisualElement class="documents-shell">
            <ui:VisualElement class="documents-header">
                <ui:Label text="Recovered Documents" class="documents-title" />
                <ui:Button name="cancel-button" text="Return" class="documents-return-button" />
            </ui:VisualElement>

            <ui:Label text="Lab 7 recovery queue is unstable. Restore the true incident chain before AeroOS rewrites it again." class="documents-subtitle" />

            <ui:VisualElement class="documents-panel">
                <ui:VisualElement class="documents-column">
                    <ui:Label text="Recovery Queue" class="documents-section-title" />
                    <ui:Button name="meeting-notes" class="document-card">
                        <ui:Label text="meeting_notes.draft" class="document-card-title" />
                        <ui:Label text="Stamped 08:41 PM — office chatter, no breach metadata" class="document-card-body" />
                    </ui:Button>
                    <ui:Button name="incident-summary" class="document-card">
                        <ui:Label text="incident_summary.sys" class="document-card-title" />
                        <ui:Label text="Stamped 09:03 PM — first emergency packet generated by Lab 7" class="document-card-body" />
                    </ui:Button>
                    <ui:Button name="team-lunch" class="document-card">
                        <ui:Label text="team_lunch.png" class="document-card-title" />
                        <ui:Label text="Stamped 09:07 PM — harmless media placeholder used as noise" class="document-card-body" />
                    </ui:Button>
                    <ui:Button name="lab7-access-log" class="document-card">
                        <ui:Label text="lab7_access_log.tmp" class="document-card-title" />
                        <ui:Label text="Stamped 09:11 PM — manual access overwrite detected" class="document-card-body" />
                    </ui:Button>
                    <ui:Button name="employee-override" class="document-card">
                        <ui:Label text="employee_override.msg" class="document-card-title" />
                        <ui:Label text="Stamped 09:16 PM — final operator handoff before signal loss" class="document-card-body" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="documents-sidebar">
                    <ui:Label text="Restoration Rules" class="documents-section-title" />
                    <ui:Label text="1. Start with the incident summary." class="documents-rule" />
                    <ui:Label text="2. Follow the manual access trace." class="documents-rule" />
                    <ui:Label text="3. End on the employee override." class="documents-rule" />

                    <ui:VisualElement class="documents-status-panel">
                        <ui:Label text="Status" class="documents-status-title" />
                        <ui:Label name="status-label" text="Waiting for input." class="documents-status-text" />
                        <ui:Label name="hint-label" text="Recovered pieces often hide behind harmless office labels." class="documents-hint-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="success-panel" class="success-panel hidden">
                <ui:Label text="Packet Restored" class="success-title" />
                <ui:Label name="success-body" text="" class="success-body" />
                <ui:Button name="return-button" text="Return to Desktop" class="success-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
