/*
2026-05-15 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
:root {
    --glass-background: rgba(200, 240, 255, 0.16);
    --glass-background-hover: rgba(255, 255, 255, 0.35);
    --glass-border: rgba(255, 255, 255, 0.55);
    --glass-highlight: rgba(255, 255, 255, 0.85);
    --taskbar-height: 84px;
    --aero-blue: #0088ff;
    --aero-glow: rgba(0, 160, 255, 0.6);
}

.desktop-root {
    flex-grow: 1;
    background-color: #000;
}

.desktop-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Image/WallpaperV2.png");
    -unity-background-scale-mode: scale-and-crop;
}

.wallpaper-hotspots {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: var(--taskbar-height);
}

.wallpaper-hotspot {
    position: absolute;
    min-width: 160px;
    height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background-color: rgba(120, 220, 255, 0.18);
    border-width: 1px;
    border-color: rgba(210, 250, 255, 0.75);
    color: white;
    -unity-font-style: bold;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 1);
}

.wallpaper-hotspot:hover {
    background-color: rgba(150, 235, 255, 0.3);
}

.wallpaper-hotspot--objective {
    background-color: rgba(120, 255, 210, 0.28);
    border-color: rgba(210, 255, 240, 0.95);
    color: #ffffff;
}

#tree-hotspot {
    right: 110px;
    bottom: 170px;
}

#city-hotspot {
    right: 230px;
    top: 160px;
}

#balloon-hotspot {
    left: 56%;
    top: 120px;
}

.objective-panel {
    position: absolute;
    top: 24px;
    right: 28px;
    width: 360px;
    padding: 18px 20px;
    background-color: rgba(195, 235, 255, 0.18);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.45);
    border-radius: 18px;
}

.objective-title {
    color: rgba(220, 245, 255, 0.92);
    font-size: 12px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.objective-text {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

.desktop-main-area {
    flex-grow: 1;
    flex-direction: column;
    flex-wrap: wrap;
    padding: 40px;
    align-items: flex-start;
}

.desktop-main-area--glitch {
    opacity: 0.97;
}

.desktop-icon-wrapper {
    width: 130px;
    height: 150px;
    align-items: center;
    justify-content: center;
    margin: 20px;
    padding: 10px;
    border-radius: 18px;
    transition-duration: 0.2s;
    overflow: hidden;
}

.desktop-icon-wrapper:hover {
    background-color: rgba(255, 255, 255, 0.22);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.4);
}

.desktop-icon-wrapper--selected {
    background-color: rgba(255, 255, 255, 0.35);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.6);
}

.desktop-icon-wrapper--haunted {
    background-color: rgba(0, 180, 255, 0.22);
    border-width: 1.5px;
    border-color: rgba(170, 255, 255, 0.85);
}

.desktop-icon-wrapper--objective {
    background-color: rgba(120, 220, 255, 0.18);
    border-width: 1.5px;
    border-color: rgba(210, 250, 255, 0.82);
}

.desktop-icon-wrapper--locked {
    opacity: 0.48;
}

.desktop-icon {
    width: 100px;
    height: 100px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 10px;
}

.desktop-icon-label {
    color: white;
    font-size: 16px;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 1);
    -unity-font-style: bold;
    white-space: normal;
    width: 100%;
}

#icon-computer { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Computer_Cropped.png"); }
#icon-documents { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Documents.png"); }
#icon-pictures { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Pictures.png"); }
#icon-videos { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Videos.png"); }
#icon-music { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Music.png"); }
#icon-network { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Network.png"); }
#icon-control-panel { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/ControlPanel.png"); }
#icon-recycle-bin { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/RecycleBin.png"); }
#icon-tetris { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/TetrisIcon.png"); }

.taskbar {
    height: var(--taskbar-height);
    background-color: var(--glass-background);
    border-top-width: 2.5px;
    border-top-color: var(--glass-highlight);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.4);
    flex-direction: row;
    padding-left: 20px;
    padding-right: 20px;
    align-items: center;
}

.taskbar-start-button {
    width: 72px;
    height: 72px;
    background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/StartOrb_Aero_v2.png");
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 24px;
    transition-duration: 0.3s;
}

.taskbar-start-button:hover {
    scale: 1.15;
}

.taskbar-start-button:active {
    scale: 0.95;
}

.taskbar-app-list {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.taskbar-app-icon {
    width: 58px;
    height: 58px;
    margin: 0 12px;
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.25s;
}

.taskbar-app-icon:hover {
    scale: 1.3;
}

.taskbar-system-tray {
    flex-direction: row;
    align-items: center;
    padding: 0 18px;
    background-color: rgba(0, 0, 0, 0.18);
    border-radius: 14px;
    height: 85%;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.tray-icon {
    width: 32px;
    height: 32px;
    margin: 0 8px;
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.15s;
    opacity: 0.95;
}

.tray-icon:hover {
    opacity: 1;
    scale: 1.25;
}

.tray-clock {
    color: white;
    font-size: 17px;
    margin-left: 18px;
    margin-right: 4px;
    -unity-font-style: bold;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 1);
}

.tray-clock--glitch {
    color: #8ffcff;
    text-shadow: 0 0 8px rgba(120, 255, 255, 0.9);
}

.start-menu {
    position: absolute;
    bottom: var(--taskbar-height);
    left: 12px;
    width: 440px;
    height: 600px;
    background-color: rgba(35, 115, 200, 0.92);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.7);
    border-radius: 12px 12px 0 0;
    transition-duration: 0.3s;
    flex-direction: row;
    padding: 10px;
}

.start-menu-left {
    width: 260px;
    background-color: white;
    border-radius: 8px;
    padding: 12px;
}

.start-menu-right {
    flex-grow: 1;
    padding: 12px;
    background-color: rgba(0, 60, 130, 0.15);
}

.start-menu-item {
    flex-direction: row;
    align-items: center;
    padding: 6px;
    border-radius: 4px;
}

.start-menu-item:hover {
    background-color: #e5f1fb;
}

.start-menu-item-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
}

.start-menu-item-label {
    color: #333;
    font-size: 14px;
}

.start-menu-right-item {
    color: white;
    font-size: 13px;
    padding: 8px 4px;
    -unity-font-style: bold;
    text-shadow: 0 1px 2px rgba(0,0,0,0.5);
}

.start-menu-right-item:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

.start-menu-separator {
    height: 1px;
    background-color: rgba(0,0,0,0.1);
    margin: 8px 0;
}

.start-menu-user-name {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    margin-top: 4px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
}

.start-menu-right-spacer {
    flex-grow: 1;
}

.start-menu-shutdown-btn {
    background-color: #d04040;
    color: white;
    border-radius: 4px;
    border-width: 1px;
    border-color: #a02020;
    padding: 6px;
}

.start-menu.hidden {
    translate: 0 650px;
    display: none;
}

.hidden {
    display: none;
}

.app-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.desktop-toast {
    position: absolute;
    right: 24px;
    bottom: 104px;
    width: 320px;
    padding: 18px;
    background-color: rgba(195, 235, 255, 0.22);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
    border-radius: 18px;
    opacity: 0;
    translate: 0 40px;
    transition-property: opacity, translate;
    transition-duration: 0.35s;
}

.desktop-toast--visible {
    opacity: 1;
    translate: 0 0;
}

.desktop-toast-title {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.desktop-toast-body {
    color: rgba(235, 248, 255, 0.92);
    font-size: 13px;
    white-space: normal;
}

.desktop-fake-window {
    position: absolute;
    width: 500px;
    left: 50%;
    top: 16%;
    margin-left: -250px;
    padding: 22px 24px;
    background-color: rgba(16, 33, 58, 0.94);
    border-width: 1.5px;
    border-color: rgba(198, 234, 255, 0.82);
    border-radius: 18px;
    opacity: 0;
    scale: 0.94 0.94;
    transition-property: opacity, scale;
    transition-duration: 0.28s;
    box-shadow: 0 18px 60px rgba(0, 12, 32, 0.46);
}

.desktop-fake-window--visible {
    opacity: 1;
    scale: 1 1;
}

.desktop-fake-window-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.desktop-fake-window-header-text {
    flex-grow: 1;
}

.desktop-fake-window-icon {
    width: 52px;
    height: 52px;
    margin-right: 14px;
    border-radius: 12px;
    background-color: rgba(120, 210, 255, 0.16);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.34);
    -unity-background-scale-mode: scale-to-fit;
}

.desktop-fake-window-title {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.desktop-fake-window-status {
    color: rgba(196, 242, 255, 0.95);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}

.desktop-fake-window-progress-track {
    height: 10px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    margin-bottom: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.desktop-fake-window-progress-fill {
    height: 100%;
    width: 0;
    background-color: rgba(131, 227, 255, 0.92);
    border-radius: 999px;
}

.desktop-fake-window-body {
    color: rgba(245, 250, 255, 0.98);
    font-size: 15px;
    white-space: normal;
    line-height: 1.25;
    margin-bottom: 12px;
}

.desktop-fake-window-module {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 10px 12px;
    margin-bottom: 14px;
}

.desktop-fake-window-module-row {
    color: rgba(228, 244, 255, 0.96);
    font-size: 13px;
    margin-bottom: 6px;
    unity-font-definition: none;
}

.desktop-fake-window-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.desktop-fake-window-button {
    min-width: 118px;
    height: 36px;
    margin-left: 10px;
    border-radius: 10px;
    background-color: rgba(110, 190, 255, 0.34);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.58);
    color: white;
}

.desktop-fake-window-button--secondary {
    background-color: rgba(255, 255, 255, 0.1);
}

.desktop-fake-window--warning {
    background-color: rgba(71, 52, 14, 0.96);
    border-color: rgba(255, 225, 128, 0.8);
}

.desktop-fake-window--critical {
    background-color: rgba(64, 20, 31, 0.96);
    border-color: rgba(255, 163, 181, 0.78);
}

.desktop-fake-window--echo {
    background-color: rgba(11, 43, 76, 0.96);
    border-color: rgba(184, 229, 255, 0.82);
}

.desktop-fake-window-icon--music { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Music.png"); }
.desktop-fake-window-icon--computer { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Computer_Cropped.png"); }
.desktop-fake-window-icon--network { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Network.png"); }
.desktop-fake-window-icon--control { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/ControlPanel.png"); }
.desktop-fake-window-icon--videos { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Videos.png"); }
.desktop-fake-window-icon--pictures { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Pictures.png"); }

.desktop-fake-window--warning .desktop-fake-window-progress-fill {
    background-color: rgba(255, 223, 120, 0.96);
}

.desktop-fake-window--critical .desktop-fake-window-progress-fill {
    background-color: rgba(255, 140, 167, 0.96);
}

.glass-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    transition-duration: 0.1s;
}

.glass-overlay--active {
    opacity: 0.8;
}

.phantom-chat {
    position: absolute;
    top: 60px;
    right: 40px;
    width: 280px;
    background-color: rgba(200, 240, 255, 0.35);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.6);
    border-radius: 12px;
    flex-direction: row;
    padding: 12px;
    opacity: 0;
    translate: 100px 0;
    transition-property: opacity, translate;
    transition-duration: 0.4s;
    align-items: center;
}

.phantom-chat--visible {
    opacity: 1;
    translate: 0 0;
}

.phantom-chat-icon {
    width: 42px;
    height: 42px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.phantom-chat-text {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
    flex-grow: 1;
}

.ghost-window {
    position: absolute;
    width: 350px;
    height: 250px;
    background-color: rgba(220, 245, 255, 0.4);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.8);
    border-radius: 10px;
}

/* Expanded Clock Panel */
.clock-panel {
    position: absolute;
    bottom: var(--taskbar-height);
    right: 12px;
    width: 300px;
    background-color: rgba(35, 115, 200, 0.94);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.7);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    padding: 20px;
    transition-duration: 0.3s;
}

.clock-panel.hidden {
    translate: 0 450px;
    opacity: 0;
    display: none;
}

.clock-panel-time {
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.clock-panel-day {
    color: rgba(220, 245, 255, 0.9);
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.clock-panel-date {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.clock-panel-separator {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.3);
    margin: 10px 0;
}

.calendar-container {
    margin-top: 10px;
}

.calendar-header {
    flex-direction: row;
    justify-content: space-around;
    margin-bottom: 8px;
}

.calendar-day-header {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    width: 30px;
    -unity-text-align: middle-center;
}

.calendar-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
}

.calendar-day {
    color: white;
    font-size: 13px;
    width: 30px;
    height: 30px;
    -unity-text-align: middle-center;
    margin: 2px;
    border-radius: 4px;
}

.calendar-day--current {
    background-color: rgba(255, 255, 255, 0.3);
    -unity-font-style: bold;
    border-width: 1px;
    border-color: white;
}

.calendar-day--other-month {
    color: rgba(255, 255, 255, 0.3);
}

