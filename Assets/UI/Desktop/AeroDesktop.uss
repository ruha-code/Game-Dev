/*
2026-05-15 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
:root {
    --glass-background: rgba(200, 240, 255, 0.16);
    --glass-background-hover: rgba(255, 255, 255, 0.35);
    --glass-border: rgba(255, 255, 255, 0.55);
    --glass-highlight: rgba(255, 255, 255, 0.85);
    --taskbar-height: 84px;
    --aero-blue: #0088ff;
    --aero-glow: rgba(0, 160, 255, 0.6);
}

.desktop-root {
    flex-grow: 1;
    background-color: #000;
}

.desktop-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Image/Wallpaper.jpg");
    -unity-background-scale-mode: scale-and-crop;
}

.desktop-main-area {
    flex-grow: 1;
    flex-direction: column;
    flex-wrap: wrap;
    padding: 40px;
    align-items: flex-start;
}

.desktop-icon-wrapper {
    width: 130px;
    height: 150px;
    align-items: center;
    justify-content: center;
    margin: 20px;
    padding: 10px;
    border-radius: 18px;
    transition-duration: 0.2s;
    overflow: hidden;
}

.desktop-icon-wrapper:hover {
    background-color: rgba(255, 255, 255, 0.22);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.4);
}

.desktop-icon-wrapper--selected {
    background-color: rgba(255, 255, 255, 0.35);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.6);
}

.desktop-icon {
    width: 100px;
    height: 100px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 10px;
}

.desktop-icon-label {
    color: white;
    font-size: 16px;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 1);
    -unity-font-style: bold;
    white-space: normal;
    width: 100%;
}

#icon-computer { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Computer_Cropped.png"); }
#icon-documents { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Documents.png"); }
#icon-pictures { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Pictures.png"); }
#icon-videos { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Videos.png"); }
#icon-music { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Music.png"); }
#icon-network { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/Network.png"); }
#icon-control-panel { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/ControlPanel.png"); }
#icon-recycle-bin { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/RecycleBin.png"); }
#icon-tetris { background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/MediaPlayer.png"); }

.taskbar {
    height: var(--taskbar-height);
    background-color: var(--glass-background);
    border-top-width: 2.5px;
    border-top-color: var(--glass-highlight);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.4);
    flex-direction: row;
    padding-left: 20px;
    padding-right: 20px;
    align-items: center;
}

.taskbar-start-button {
    width: 72px;
    height: 72px;
    background-image: url("project://database/Assets/Sprites/AeroIcons_Processed/StartOrb_Aero_v2.png");
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 24px;
    transition-duration: 0.3s;
}

.taskbar-start-button:hover {
    scale: 1.15;
}

.taskbar-start-button:active {
    scale: 0.95;
}

.taskbar-app-list {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.taskbar-app-icon {
    width: 58px;
    height: 58px;
    margin: 0 12px;
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.25s;
}

.taskbar-app-icon:hover {
    scale: 1.3;
}

.taskbar-system-tray {
    flex-direction: row;
    align-items: center;
    padding: 0 18px;
    background-color: rgba(0, 0, 0, 0.18);
    border-radius: 14px;
    height: 85%;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.tray-icon {
    width: 32px;
    height: 32px;
    margin: 0 8px;
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.15s;
    opacity: 0.95;
}

.tray-icon:hover {
    opacity: 1;
    scale: 1.25;
}

.tray-clock {
    color: white;
    font-size: 17px;
    margin-left: 18px;
    margin-right: 4px;
    -unity-font-style: bold;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 1);
}

.start-menu {
    position: absolute;
    bottom: var(--taskbar-height);
    left: 12px;
    width: 420px;
    height: 580px;
    background-color: rgba(220, 240, 255, 0.45);
    border-width: 2px;
    border-color: var(--glass-highlight);
    border-radius: 12px 12px 0 0;
    transition-duration: 0.3s;
    flex-direction: row;
    padding: 8px;
}

.start-menu-left {
    flex-grow: 1;
    background-color: white;
    border-radius: 8px;
    padding: 10px;
}

.start-menu-right {
    width: 160px;
    padding: 10px;
}

.start-menu-item {
    flex-direction: row;
    align-items: center;
    padding: 6px;
    border-radius: 4px;
}

.start-menu-item:hover {
    background-color: #e5f1fb;
}

.start-menu-item-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
}

.start-menu-item-label {
    color: #333;
    font-size: 14px;
}

.start-menu-right-item {
    color: white;
    font-size: 13px;
    padding: 8px 4px;
    -unity-font-style: bold;
    text-shadow: 0 1px 2px rgba(0,0,0,0.5);
}

.start-menu-right-item:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

.start-menu-separator {
    height: 1px;
    background-color: rgba(0,0,0,0.1);
    margin: 8px 0;
}

.start-menu-user-name {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.start-menu-shutdown-btn {
    background-color: #d04040;
    color: white;
    border-radius: 4px;
    border-width: 1px;
    border-color: #a02020;
    padding: 6px;
}

.start-menu.hidden {
    translate: 0 650px;
    display: none;
}

.app-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}
