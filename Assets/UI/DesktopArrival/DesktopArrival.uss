/*
2026-05-14 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
.root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.background-dark {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: black;
    transition-duration: 2s;
}

.background-dark--hidden {
    opacity: 0;
}

.intro-container {
    align-items: center;
}

.intro-text {
    color: white;
    font-size: 40px;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-duration: 1s;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
}

.intro-text--visible {
    opacity: 1;
}

.typewriter-container {
    position: absolute;
    bottom: 100px;
    left: 100px;
}

.typewriter-line {
    color: rgba(200, 240, 255, 0.8);
    font-size: 20px;
    margin-bottom: 5px;
    -unity-font-style: bold;
}

/* Wallpaper materialization styles */
.wallpaper-container {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.wallpaper-layer {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-duration: 2s;
}

.wallpaper-layer--visible {
    opacity: 1;
}

/* UI Materialization */
.taskbar {
    position: absolute;
    bottom: -60px;
    width: 100%;
    height: 50px;
    background-color: rgba(255, 255, 255, 0.15);
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.3);
    transition-property: bottom;
    transition-duration: 1s;
}

.taskbar--visible {
    bottom: 0;
}

.icon-grid {
    position: absolute;
    top: 50px;
    left: 20px;
    width: 300px;
    flex-wrap: wrap;
    flex-direction: column;
}

.desktop-icon {
    width: 80px;
    height: 100px;
    margin: 10px;
    align-items: center;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
}

.desktop-icon--visible {
    opacity: 1;
    translate: 0 0;
}

.icon-image {
    width: 60px;
    height: 60px;
    margin-bottom: 5px;
}

.icon-label {
    color: white;
    font-size: 12px;
    -unity-text-align: middle-center;
}

/* Popup */
.popup-container {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    display: none;
}

.glass-popup {
    width: 400px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.5);
    border-radius: 20px;
    padding: 30px;
    align-items: center;
    opacity: 0;
    scale: 0.8 0.8;
    transition-property: opacity, scale;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-back;
}

.glass-popup--visible {
    opacity: 1;
    scale: 1 1;
}

.popup-title {
    color: white;
    font-size: 28px;
    margin-bottom: 12px;
    -unity-font-style: bold;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.popup-message {
    color: rgba(230, 250, 255, 0.9);
    font-size: 17px;
    -unity-text-align: middle-center;
}

/* Glitch Overlay */
.glitch-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: white;
    opacity: 0;
}

.glitch-rgb {
    background-color: rgba(255, 0, 0, 0.2);
}

.silhouette {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/UI/Textures/HumanShadow.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0;
}
