/*
AeroOS Main Menu Styles
*/
:root {
    --color-primary: #a3e0ff;
    --color-text: #ffffff;
    --color-glass-bg: rgba(255, 255, 255, 0.05);
    --color-glass-border: rgba(255, 255, 255, 0.15);
    --color-highlight: rgba(120, 209, 255, 0.2);
    --spacing-lg: 80px;
    --border-radius: 15px;
}

.main-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/background_menu.png");
    -unity-background-scale-mode: scale-and-crop;
    padding: var(--spacing-lg);
    justify-content: space-between;
}

.header {
    margin-bottom: 40px;
}

.title {
    font-size: 160px;
    color: #ffffff;
    -unity-font-style: bold;
    margin-bottom: -10px;
    text-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
}

.subtitle {
    font-size: 18px;
    color: var(--color-primary);
    letter-spacing: 25px;
    opacity: 0.8;
    margin-left: 10px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.menu-box {
    background-color: var(--color-glass-bg);
    border-width: 1.5px;
    border-color: var(--color-glass-border);
    border-radius: var(--border-radius);
    padding: 8px;
    width: 420px;
    border-top-color: rgba(255, 255, 255, 0.3); /* Subtle top highlight */
}

.menu-item {
    flex-direction: row;
    align-items: center;
    padding: 16px 24px;
    margin: 4px;
    border-radius: 10px;
    transition-duration: 0.2s;
    overflow: hidden; /* For active background */
}

.menu-item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.menu-item-active {
    /* No solid color here, we use AeroActiveBackground in UXML */
}

.menu-item-content {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.menu-icon {
    width: 32px;
    height: 32px;
    margin-right: 20px;
    -unity-background-image-tint-color: white;
}

.menu-text {
    font-size: 26px;
    color: var(--color-text);
    flex-grow: 1;
    -unity-font-style: normal;
}

.menu-chevron {
    width: 20px;
    height: 20px;
    -unity-background-image-tint-color: white;
    opacity: 0.7;
}

.swoosh-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 200px;
}

.footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.user-section {
    flex-direction: row;
    align-items: center;
}

.user-icon {
    width: 48px;
    height: 48px;
    margin-right: 15px;
    -unity-background-image-tint-color: white;
}

.user-welcome {
    font-size: 20px;
    color: var(--color-text);
    -unity-font-style: bold;
}

.user-subtext {
    font-size: 15px;
    color: var(--color-text);
    opacity: 0.7;
}

.version-text {
    font-size: 14px;
    color: var(--color-text);
    opacity: 0.4;
}
