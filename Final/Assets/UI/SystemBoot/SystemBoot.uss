/*
2026-05-14 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
.root {
    flex-grow: 1;
    background-color: black;
    align-items: center;
    justify-content: center;
}

.background-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 2s ease-in-out;
}

.background-glow--visible {
    opacity: 1;
}

.content-container {
    align-items: center;
    justify-content: center;
}

.logo {
    font-size: 80px;
    color: white;
    -unity-font-style: bold;
    opacity: 0;
    transition: opacity 1s ease-in-out;
    text-shadow: 0 0 25px rgba(0, 180, 255, 0.9);
}

.logo--visible {
    opacity: 1;
}

.loading-container {
    margin-top: 50px;
    width: 400px;
    height: 10px;
    background-color: rgba(0, 50, 100, 0.4);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.5s ease-in;
}

.loading-container--visible {
    opacity: 1;
}

.loading-bar {
    width: 0%;
    height: 100%;
    background-color: rgb(0, 180, 255);
    border-radius: 5px;
    /* Simulate gloss with a child or gradient if possible, 
       but here we'll use a semi-transparent highlight in UXML if needed.
       For now, just a bright cyan. */
}

.setup-panel {
    position: absolute;
    width: 550px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 24px;
    padding: 50px;
    align-items: center;
    opacity: 0;
    scale: 0.8 0.8;
    transition: opacity 1s ease-out, scale 1s ease-out;
    display: none;
    /* Blur effect is not supported in USS, 
       so we rely on the background elements for depth. */
}

.setup-panel--visible {
    opacity: 1;
    scale: 1 1;
    display: flex;
}

/* Glossy highlight for the panel */
.glass-reflection {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
}

.setup-title {
    font-size: 36px;
    color: white;
    margin-bottom: 12px;
    -unity-font-style: bold;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.setup-subtitle {
    font-size: 20px;
    color: rgba(230, 245, 255, 0.9);
    margin-bottom: 40px;
}

.name-input {
    width: 100%;
    margin-bottom: 40px;
    color: white;
    font-size: 18px;
}

.name-input #unity-text-input {
    background-color: rgba(0, 20, 40, 0.5);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 12px;
    color: white;
}

.name-input #unity-text-input:focus {
    border-color: rgba(0, 180, 255, 0.8);
    background-color: rgba(0, 30, 60, 0.6);
}

.continue-button {
    background-color: rgba(0, 140, 255, 0.5);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 30px;
    padding: 15px 50px;
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    transition: background-color 0.3s, scale 0.2s;
}

.continue-button:hover {
    background-color: rgba(0, 170, 255, 0.7);
    scale: 1.05 1.05;
}

.continue-button:active {
    background-color: rgba(0, 110, 255, 0.9);
    scale: 0.95 0.95;
}

/* Glitch Effects */
.glitch-distort {
    translate: 30px 0;
}

.glitch-rgb {
    -unity-background-image-tint-color: rgba(255, 80, 80, 0.7);
}

.glitch-static {
    background-color: rgba(255, 255, 255, 0.08);
}
